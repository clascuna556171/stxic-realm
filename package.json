{
  "name": "stxic-realm",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.22.0",
  "scripts": {
    "dev": "pnpm --filter @realm/web dev",
    "build": "pnpm --filter @realm/web build",
    "typecheck": "pnpm --filter @realm/web typecheck",
    "test": "pnpm --filter @realm/web test",
    "test:database": "node supabase/tests/run-local.mjs",
    "test:access:ui": "node apps/web/scripts/verify-access-ui.mjs",
    "test:world:ui": "node apps/web/scripts/verify-world-ui.mjs",
    "test:hall:ui": "node apps/web/scripts/verify-hall-studio-ui.mjs",
    "test:poses:ui": "node apps/web/scripts/verify-furniture-poses-ui.mjs",
    "test:activity:ui": "node apps/web/scripts/verify-world-activity-ui.mjs",
    "test:items:ui": "node apps/web/scripts/verify-item-actions-ui.mjs",
    "test:interaction:ui": "node apps/web/scripts/verify-direct-interaction-ui.mjs",
    "test:world:polish:ui": "node apps/web/scripts/verify-world-polish-ui.mjs",
    "test:world:social:ui": "node apps/web/scripts/verify-world-social-ui.mjs",
    "test:profile:ui": "node apps/web/scripts/verify-profile-ui.mjs",
    "release:preflight": "node scripts/release-preflight.mjs",
    "test:access:integration": "pnpm --filter @realm/web test:access",
    "test:integration": "pnpm --filter @realm/web test:integration",
    "test:social": "pnpm --filter @realm/web test:social",
    "test:social:sql": "node scripts/refuse-linked-sql.mjs",
    "setup:team": "powershell -ExecutionPolicy Bypass -File scripts/setup-team.ps1"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.12",
    "playwright": "1.64.1"
  }
}
